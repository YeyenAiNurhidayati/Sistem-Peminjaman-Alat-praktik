# Environment Mode
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL / TiDB Cloud Starter)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peminjaman_alat
DB_SSL=false

# Session Security
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# Seed Initial User Passwords (digunakan saat pertama kali inisialisasi basis data)
# Wajib diisi dengan password kuat, tidak pernah disimpan plaintext di repositori
SEED_ADMIN_PASSWORD=
SEED_GURU_PASSWORD=
SEED_SISWA_PASSWORD=

# Cloud Storage (Vercel Blob / Cloudinary)
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
