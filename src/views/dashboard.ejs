<%- include('layout/header') %>
<%- include('layout/sidebar') %>

<div id="main">
    <header class="mb-3">
        <a href="#" class="burger-btn d-block d-xl-none">
            <i class="bi bi-justify fs-3"></i>
        </a>
    </header>

    <div class="page-heading">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <img src="<%= profilePicUrl %>" alt="Profile" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover; border: 2px solid #fff; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
                <div>
                    <h3>Dashboard</h3>
                    <p class="text-muted mb-0">
                        <img src="/assets/images/logo.jpg" alt="Logo" style="width: 30px; height: 30px; margin-right: 8px; vertical-align: middle;">
                        Selamat datang kembali, <strong><%= nama %></strong>!
                    </p>
                </div>
            </div>
            <div class="text-end">
                <span class="badge bg-primary fs-6">
                    <i class="bi bi-person-badge"></i> <%= role ? role.charAt(0).toUpperCase() + role.slice(1) : '' %>
                </span>
            </div>
        </div>
    </div>

    <div class="page-content">
        <!-- Stats Cards -->
        <div class="row g-4 mb-4">
            <!-- Total Alat -->
            <div class="col-6 col-lg-3 col-md-6">
                <div class="card card-stats shadow h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-tools fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">Total Alat</h6>
                                <h3 class="mb-0 fw-bold"><%= totalAlat %></h3>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <a href="/alat" class="text-decoration-none small">
                                <i class="bi bi-arrow-right"></i> Lihat Detail
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alat Tersedia -->
            <div class="col-6 col-lg-3 col-md-6">
                <div class="card card-stats shadow h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-check-circle fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">Alat Tersedia</h6>
                                <h3 class="mb-0 fw-bold text-success"><%= alatTersedia %></h3>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <span class="small text-muted">
                                <i class="bi bi-box-seam"></i> Siap dipinjam
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <% if (role === 'admin' || role === 'guru') { %>
            <!-- Peminjaman Aktif -->
            <div class="col-6 col-lg-3 col-md-6">
                <div class="card card-stats shadow h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-arrow-left-right fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">Sedang Dipinjam</h6>
                                <h3 class="mb-0 fw-bold text-info"><%= peminjamanAktif %></h3>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <a href="/peminjaman" class="text-decoration-none small">
                                <i class="bi bi-arrow-right"></i> Kelola
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Menunggu Setuju -->
            <div class="col-6 col-lg-3 col-md-6">
                <div class="card card-stats shadow h-100 <%= pendingApprovals > 0 ? 'border-warning' : '' %>">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-hourglass-split fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">Menunggu Setuju</h6>
                                <h3 class="mb-0 fw-bold text-warning"><%= pendingApprovals %></h3>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <% if (pendingApprovals > 0) { %>
                                <a href="/peminjaman" class="text-decoration-none small text-warning fw-bold">
                                    <i class="bi bi-exclamation-triangle"></i> Perlu diproses!
                                </a>
                            <% } else { %>
                                <span class="small text-success">
                                    <i class="bi bi-check-all"></i> Semua sudah diproses
                                </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <% if (role === 'siswa') { %>
            <!-- Peminjaman Saya -->
            <div class="col-6 col-lg-3 col-md-6">
                <div class="card card-stats shadow h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-bag fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">Pinjaman Aktif</h6>
                                <h3 class="mb-0 fw-bold text-warning"><%= myLoans %></h3>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <a href="/peminjaman" class="text-decoration-none small">
                                <i class="bi bi-arrow-right"></i> Lihat Pinjaman
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Riwayat -->
            <div class="col-6 col-lg-3 col-md-6">
                <div class="card card-stats shadow h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-clock-history fs-5"></i>
                            </div>
                            <div class="ms-3">
                                <h6 class="text-muted mb-1">Sudah Kembali</h6>
                                <h3 class="mb-0 fw-bold"><%= totalKembali %></h3>
                            </div>
                        </div>
                        <div class="mt-3 pt-2 border-top">
                            <a href="/peminjaman" class="text-decoration-none small">
                                <i class="bi bi-arrow-right"></i> Lihat Riwayat
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Recent Activity for Admin & Guru -->
        <% if (role === 'admin' || role === 'guru') { %>
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-activity me-2"></i>Aktivitas Terbaru</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Peminjam</th>
                                        <th>Barang</th>
                                        <th>Tanggal</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (recentActivities && recentActivities.length > 0) { %>
                                        <% recentActivities.forEach(function(r) { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 35px; height: 35px; font-size: 14px;">
                                                        <%= r.nama_peminjam ? r.nama_peminjam.charAt(0).toUpperCase() : 'U' %>
                                                    </div>
                                                    <%= r.nama_peminjam %>
                                                </div>
                                            </td>
                                            <td><%= r.nama_barang %></td>
                                            <td><%= new Date(r.tgl_pinjam).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                            <td>
                                                <% 
                                                var badge = 'secondary';
                                                var icon = 'clock';
                                                if (r.status === 'pending') { badge = 'warning'; icon = 'hourglass-split'; }
                                                else if (r.status === 'disetujui') { badge = 'primary'; icon = 'check-circle'; }
                                                else if (r.status === 'menunggu_pengembalian') { badge = 'info'; icon = 'arrow-repeat'; }
                                                else if (r.status === 'kembali') { badge = 'success'; icon = 'check2-all'; }
                                                else if (r.status === 'ditolak') { badge = 'danger'; icon = 'x-circle'; }
                                                %>
                                                <span class="badge bg-<%= badge %>">
                                                    <i class="bi bi-<%= icon %>"></i> <%= r.status.replace('_', ' ') %>
                                                </span>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                Belum ada aktivitas
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <a href="/peminjaman" class="btn btn-sm btn-primary">
                            <i class="bi bi-list-ul"></i> Lihat Semua
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Quick Actions for Siswa -->
        <% if (role === 'siswa') { %>
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Aksi Cepat</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <a href="/peminjaman" class="btn btn-outline-primary w-100 py-3">
                                    <i class="bi bi-plus-circle fs-4 d-block mb-2"></i>
                                    Ajukan Peminjaman
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="/alat" class="btn btn-outline-info w-100 py-3">
                                    <i class="bi bi-search fs-4 d-block mb-2"></i>
                                    Lihat Daftar Alat
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="/peminjaman" class="btn btn-outline-secondary w-100 py-3">
                                    <i class="bi bi-clock-history fs-4 d-block mb-2"></i>
                                    Riwayat Peminjaman
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <%- include('layout/footer') %>
</div>
