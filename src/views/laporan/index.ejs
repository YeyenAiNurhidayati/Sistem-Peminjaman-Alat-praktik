<%- include('../layout/header') %>
<%- include('../layout/sidebar') %>

<div id="main">
    <div class="page-heading d-flex justify-content-between align-items-center">
        <div>
            <h3>Laporan Peminjaman</h3>
            <p class="text-muted">Data peminjaman & pengembalian alat</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/laporan/cetak/pdf<%= typeof queryString !== 'undefined' && queryString ? '?' + queryString : '' %>" target="_blank" class="btn btn-danger">
                <i class="bi bi-file-earmark-pdf"></i> Cetak PDF
            </a>
            <a href="/laporan/cetak/csv<%= typeof queryString !== 'undefined' && queryString ? '?' + queryString : '' %>" class="btn btn-success">
                <i class="bi bi-file-earmark-spreadsheet"></i> Ekspor CSV
            </a>
        </div>
    </div>

    <div class="page-content">
        <!-- Filter Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="GET" action="/laporan" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Tanggal Mulai</label>
                        <input type="date" class="form-control" name="tgl_mulai" value="<%= filters.tgl_mulai || '' %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tanggal Selesai</label>
                        <input type="date" class="form-control" name="tgl_selesai" value="<%= filters.tgl_selesai || '' %>">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Status</label>
                        <select class="form-select" name="status">
                            <option value="">Semua Status</option>
                            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="disetujui" <%= filters.status === 'disetujui' ? 'selected' : '' %>>Disetujui</option>
                            <option value="menunggu_pengembalian" <%= filters.status === 'menunggu_pengembalian' ? 'selected' : '' %>>Menunggu Review</option>
                            <option value="kembali" <%= filters.status === 'kembali' ? 'selected' : '' %>>Kembali</option>
                            <option value="ditolak" <%= filters.status === 'ditolak' ? 'selected' : '' %>>Ditolak</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Peminjam</label>
                        <input type="text" class="form-control" name="peminjam" placeholder="Cari peminjam..." value="<%= filters.peminjam || '' %>">
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-filter"></i> Filter
                        </button>
                        <a href="/laporan" class="btn btn-secondary" title="Reset Filter">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table Card -->
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>No</th>
                                <th>Nama Peminjam</th>
                                <th>Barang</th>
                                <th>Tgl Pinjam</th>
                                <th>Tgl Kembali</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (data && data.length > 0) { %>
                                <% data.forEach((r, index) => { %>
                                    <tr>
                                        <td><%= (pagination.currentPage - 1) * pagination.limit + index + 1 %></td>
                                        <td><%= r.nama_peminjam %></td>
                                        <td><%= r.nama_barang %></td>
                                        <td><%= new Date(r.tgl_pinjam).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                        <td><%= r.tgl_kembali ? new Date(r.tgl_kembali).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></td>
                                        <td>
                                            <% 
                                                let badgeClass = 'secondary';
                                                let label = r.status;
                                                if (r.status === 'kembali') { badgeClass = 'success'; label = 'Kembali'; }
                                                else if (r.status === 'pending') { badgeClass = 'warning'; label = 'Pending'; }
                                                else if (r.status === 'disetujui') { badgeClass = 'primary'; label = 'Disetujui'; }
                                                else if (r.status === 'menunggu_pengembalian') { badgeClass = 'info'; label = 'Menunggu Review'; }
                                                else if (r.status === 'ditolak') { badgeClass = 'danger'; label = 'Ditolak'; }
                                            %>
                                            <span class="badge bg-<%= badgeClass %>">
                                                <%= label %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Tidak ada data peminjaman yang sesuai dengan filter.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (pagination.totalPages > 1) { %>
                    <nav class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">Menampilkan <%= data.length %> dari total <%= pagination.totalRows %> data</small>
                        <ul class="pagination pagination-sm mb-0">
                            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                                <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="/laporan?page=<%= p %>&limit=<%= pagination.limit %><%= queryString ? '&' + queryString : '' %>"><%= p %></a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer') %>
