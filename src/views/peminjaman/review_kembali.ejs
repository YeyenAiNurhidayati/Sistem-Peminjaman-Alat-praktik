<%- include('../layout/header') %>
<%- include('../layout/sidebar') %>

<div id="main">
    <header class="mb-3">
        <a href="#" class="burger-btn d-block d-xl-none">
            <i class="bi bi-justify fs-3"></i>
        </a>
    </header>

    <div class="page-heading">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3><i class="bi bi-clipboard-check"></i> Review Pengembalian Barang</h3>
                <p class="text-muted">Verifikasi dan persetujui pengembalian barang dari siswa</p>
            </div>
            <div>
                <span class="badge bg-warning me-2">
                    <i class="bi bi-hourglass-split"></i> Menunggu: <%= count_menunggu %>
                </span>
                <span class="badge bg-success">
                    <i class="bi bi-check-circle"></i> Sudah Kembali: <%= count_sudah_kembali %>
                </span>
            </div>
        </div>
    </div>

    <div class="page-content">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-list-check"></i> Daftar Pengembalian Menunggu Persetujuan
                </h5>
            </div>

            <div class="card-body">
                <% if (!data || data.length === 0) { %>
                    <div class="alert alert-success text-center py-5">
                        <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
                        <h4 class="mt-3">Semua Pengembalian Sudah Diproses!</h4>
                        <p class="text-muted">Tidak ada pengembalian menunggu persetujuan saat ini.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">No</th>
                                    <th>Nama Peminjam</th>
                                    <th>Barang</th>
                                    <th>Tgl Pinjam</th>
                                    <th>Catatan</th>
                                    <th>Bukti</th>
                                    <th style="width: 200px;" class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% data.forEach((row, index) => { %>
                                    <tr>
                                        <td><strong><%= index + 1 %></strong></td>
                                        <td>
                                            <strong><%= row.nama_peminjam %></strong>
                                            <br>
                                            <small class="text-muted d-block">
                                                <%= row.nisn ? '📌 NISN: ' + row.nisn : (row.nip ? '👨‍🏫 NIP: ' + row.nip : '') %>
                                            </small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info" style="font-size: 0.9rem;">
                                                <%= row.nama_barang %>
                                            </span>
                                        </td>
                                        <td>
                                            <small><%= new Date(row.tgl_pinjam).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></small>
                                        </td>
                                        <td>
                                            <small class="text-muted d-block" style="max-width: 150px; word-wrap: break-word;">
                                                <%= row.catatan_pengembalian || '-' %>
                                            </small>
                                        </td>
                                        <td>
                                            <% if (row.bukti_kembali) { %>
                                                <button class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#buktiModal<%= row.id %>">
                                                    <i class="bi bi-eye"></i> Lihat Bukti
                                                </button>
                                            <% } else { %>
                                                <span class="badge bg-danger">Belum Ada</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-success btn-sm" onclick="accKembali(<%= row.id %>, '<%= row.nama_barang.replace(/'/g, "\\'") %>')">
                                                <i class="bi bi-check-lg"></i> Terima
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="tolakKembali(<%= row.id %>, '<%= row.nama_barang.replace(/'/g, "\\'") %>')">
                                                <i class="bi bi-x-lg"></i> Tolak
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Modal Bukti -->
                                    <% if (row.bukti_kembali) { %>
                                        <div class="modal fade" id="buktiModal<%= row.id %>" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-primary text-white">
                                                        <h5 class="modal-title">Bukti Pengembalian</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-center">
                                                        <p class="mb-3">
                                                            <strong><%= row.nama_peminjam %></strong> - 
                                                            <strong><%= row.nama_barang %></strong>
                                                        </p>
                                                        <img src="/peminjaman/bukti/<%= row.bukti_kembali %>" 
                                                             alt="Bukti Pengembalian" 
                                                             class="img-fluid" 
                                                             style="max-height: 500px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);"
                                                             onerror="this.onerror=null; this.src='/assets/uploads/bukti_kembali/<%= row.bukti_kembali %>';">
                                                        <div class="mt-4 text-start bg-light p-3 rounded">
                                                            <strong>Catatan Pengembalian:</strong>
                                                            <p class="mb-0 text-muted"><%= row.catatan_pengembalian || 'Tidak ada catatan' %></p>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Tutup</button>
                                                        <button type="button" class="btn btn-success" onclick="accKembali(<%= row.id %>, '<%= row.nama_barang.replace(/'/g, "\\'") %>', true)">
                                                            <i class="bi bi-check-lg"></i> Terima Pengembalian
                                                        </button>
                                                        <button type="button" class="btn btn-danger" onclick="tolakKembali(<%= row.id %>, '<%= row.nama_barang.replace(/'/g, "\\'") %>', true)">
                                                            <i class="bi bi-x-lg"></i> Tolak
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('../layout/footer') %>
</div>

<script>
const csrfToken = '<%= csrfToken %>';

function accKembali(id, barang, fromModal = false) {
    Swal.fire({
        title: 'Terima Pengembalian?',
        html: `Apakah Anda yakin ingin menyetujui pengembalian barang <strong>${barang}</strong>?<br><small class="text-muted">Stok barang akan otomatis bertambah 1.</small>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#28a745',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="bi bi-check-lg"></i> Ya, Terima!',
        cancelButtonText: 'Batal'
    }).then((result) => {
        if (result.isConfirmed) {
            sendReviewAction(id, 'acc_kembali', null, fromModal);
        }
    });
}

function tolakKembali(id, barang, fromModal = false) {
    Swal.fire({
        title: 'Tolak Pengembalian?',
        html: `Alasan penolakan pengembalian barang <strong>${barang}</strong>:`,
        input: 'textarea',
        inputPlaceholder: 'Jelaskan alasan penolakan (mis: barang belum dicek fisik, kondisi rusak tidak dilaporkan)...',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: '<i class="bi bi-x-lg"></i> Ya, Tolak!',
        cancelButtonText: 'Batal',
        inputValidator: (value) => {
            if (!value || value.trim().length === 0) {
                return 'Alasan penolakan wajib diisi agar siswa dapat memperbaiki!';
            }
        }
    }).then((result) => {
        if (result.isConfirmed) {
            sendReviewAction(id, 'tolak_kembali', result.value, fromModal);
        }
    });
}

function sendReviewAction(id, action, catatan, fromModal) {
    Swal.fire({
        title: 'Memproses...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
    });

    fetch(`/api/peminjaman/${id}/review`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({
            action: action,
            catatan_penolakan: catatan || ''
        })
    })
    .then(res => res.json())
    .then(result => {
        if (result.success) {
            if (fromModal) {
                const modalEl = document.getElementById(`buktiModal${id}`);
                if (modalEl) bootstrap.Modal.getInstance(modalEl)?.hide();
            }
            Swal.fire({
                icon: 'success',
                title: 'Berhasil!',
                text: result.message,
                timer: 2000,
                showConfirmButton: false
            }).then(() => location.reload());
        } else {
            Swal.fire('Error', result.message, 'error');
        }
    })
    .catch(() => {
        Swal.fire('Error', 'Terjadi kesalahan sistem saat memproses review pengembalian.', 'error');
    });
}
</script>
