<%- include('../layout/header') %>
<%- include('../layout/sidebar') %>

<div id="main">
    <header class="mb-3">
        <a href="#" class="burger-btn d-block d-xl-none">
            <i class="bi bi-justify fs-3"></i>
        </a>
    </header>

    <div class="page-heading">
        <h3>Riwayat Peminjaman</h3>
        <p class="text-muted">Daftar transaksi peminjaman alat yang telah selesai dikembalikan</p>
    </div>

    <div class="page-content">
        <div class="card shadow">
            <div class="card-body">
                <table class="table table-striped table-hover" id="table1">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Nama Peminjam</th>
                            <th>Barang</th>
                            <th>Tanggal Pinjam</th>
                            <th>Tanggal Kembali</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (riwayat && riwayat.length > 0) { %>
                            <% riwayat.forEach((row, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= row.nama_peminjam %></td>
                                    <td><%= row.nama_barang %></td>
                                    <td><%= new Date(row.tgl_pinjam).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                                    <td><%= row.tgl_kembali ? new Date(row.tgl_kembali).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></td>
                                    <td>
                                        <span class="badge bg-success">
                                            <i class="bi bi-check2-circle"></i> Selesai (Kembali)
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Belum ada riwayat peminjaman yang selesai</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <%- include('../layout/footer') %>
</div>
