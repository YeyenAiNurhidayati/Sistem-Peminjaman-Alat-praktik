<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Registrasi Siswa | Peminjaman Alat Bengkel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/compiled/css/custom.css">
</head>

<body class="login-page">
    <!-- Floating Shapes Background -->
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="login-container" style="max-width: 520px;">
        <div class="login-card">
            <!-- Header -->
            <div class="login-header">
                <div class="logo-circle">
                    <img src="/assets/logo_smk5.png" alt="Logo SMK">
                </div>
                <h1>Registrasi Siswa</h1>
                <p>Buat Akun Peminjaman Alat Bengkel</p>
            </div>

            <!-- Body -->
            <div class="login-body">
                <!-- Role Badge -->
                <div class="text-center mb-3">
                    <span class="badge bg-info px-3 py-2"><i class="bi bi-person me-1"></i>Pendaftaran Akun Siswa</span>
                </div>

                <!-- Error Alert -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert-custom alert-danger-custom">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <!-- Register Form -->
                <form method="POST" action="/auth/register" id="registerForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-floating position-relative mb-3">
                        <i class="bi bi-card-text input-icon"></i>
                        <input type="text" class="form-control" id="nama" name="nama" placeholder="Nama Lengkap" required autofocus value="<%= typeof old !== 'undefined' && old.nama ? old.nama : '' %>">
                        <label for="nama">Nama Lengkap Siswa <span class="text-danger">*</span></label>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-floating position-relative">
                                <i class="bi bi-credit-card input-icon"></i>
                                <input type="number" class="form-control" id="nisn" name="nisn" placeholder="NISN" value="<%= typeof old !== 'undefined' && old.nisn ? old.nisn : '' %>">
                                <label for="nisn">NISN / NIS</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select class="form-select" id="kelas" name="kelas" required>
                                    <option value="">-- Pilih Kelas --</option>
                                    <option value="10A" <%= typeof old !== 'undefined' && old.kelas === '10A' ? 'selected' : '' %>>10A</option>
                                    <option value="10B" <%= typeof old !== 'undefined' && old.kelas === '10B' ? 'selected' : '' %>>10B</option>
                                    <option value="10C" <%= typeof old !== 'undefined' && old.kelas === '10C' ? 'selected' : '' %>>10C</option>
                                    <option value="11A" <%= typeof old !== 'undefined' && old.kelas === '11A' ? 'selected' : '' %>>11A</option>
                                    <option value="11B" <%= typeof old !== 'undefined' && old.kelas === '11B' ? 'selected' : '' %>>11B</option>
                                    <option value="11C" <%= typeof old !== 'undefined' && old.kelas === '11C' ? 'selected' : '' %>>11C</option>
                                    <option value="12A" <%= typeof old !== 'undefined' && old.kelas === '12A' ? 'selected' : '' %>>12A</option>
                                    <option value="12B" <%= typeof old !== 'undefined' && old.kelas === '12B' ? 'selected' : '' %>>12B</option>
                                    <option value="12C" <%= typeof old !== 'undefined' && old.kelas === '12C' ? 'selected' : '' %>>12C</option>
                                </select>
                                <label for="kelas">Kelas <span class="text-danger">*</span></label>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating position-relative mb-3">
                        <i class="bi bi-person input-icon"></i>
                        <input type="text" class="form-control" id="username" name="username" placeholder="Username" required value="<%= typeof old !== 'undefined' && old.username ? old.username : '' %>">
                        <label for="username">Username Login <span class="text-danger">*</span></label>
                    </div>

                    <div class="form-floating position-relative mb-3">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password" class="form-control" id="password" name="password" placeholder="Password" required minlength="6">
                        <label for="password">Password (Min. 10 Karakter, Huruf Besar, Kecil, & Angka) <span class="text-danger">*</span></label>
                        <button type="button" class="password-toggle" onclick="togglePassword('password', 'toggleIcon1')">
                            <i class="bi bi-eye" id="toggleIcon1"></i>
                        </button>
                    </div>

                    <div class="form-floating position-relative mb-3">
                        <i class="bi bi-shield-lock input-icon"></i>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Konfirmasi Password" required minlength="6">
                        <label for="confirmPassword">Konfirmasi Password <span class="text-danger">*</span></label>
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword', 'toggleIcon2')">
                            <i class="bi bi-eye" id="toggleIcon2"></i>
                        </button>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="bi bi-person-plus-fill me-1"></i>
                        <span>Daftar Akun Siswa</span>
                    </button>

                    <div class="text-center mt-3">
                        <span class="text-muted small">Sudah memiliki akun?</span>
                        <a href="/auth/login" class="small fw-bold text-primary text-decoration-none ms-1">Masuk di sini</a>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="login-footer">
                <i class="bi bi-building me-1"></i>
                Sistem Peminjaman Alat Bengkel<br>
                <strong>SMKN 5 Kuningan</strong>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        function togglePassword(inputId, iconId) {
            const password = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (password.type === 'password') {
                password.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                password.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        // Add loading state on submit
        document.getElementById('registerForm').addEventListener('submit', function() {
            const btn = this.querySelector('.btn-login');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memproses Registrasi...';
            btn.disabled = true;
        });
    </script>
</body>
</html>
